# LitebansU environment file
# Copy this to .env and fill in your own values, or use /install.php instead.

# ============================================================
# Database (required) — the same database your LiteBans plugin writes to
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=litebans
DB_USER=root
DB_PASS=
DB_DRIVER=mysql
TABLE_PREFIX=litebans_

# ============================================================
# Site
# ============================================================
SITE_NAME=LiteBansU
FOOTER_SITE_NAME=YourSite
SITE_URL=https://yoursite.com
SITE_DESCRIPTION=Public interface for viewing server punishments and bans
TIMEZONE=UTC
DATE_FORMAT=Y-m-d H:i:s
ITEMS_PER_PAGE=20
DEFAULT_THEME=dark
DEFAULT_LANGUAGE=en

# ============================================================
# Admin login
# ============================================================
ADMIN_ENABLED=true
# Generate this hash at /hash.php, then delete that file
ADMIN_PASSWORD=
ALLOW_PASSWORD_LOGIN=true

# Require every page to be signed in to view (private server)
REQUIRE_LOGIN=false

# ============================================================
# Google sign-in (optional)
# Console: https://console.cloud.google.com/
# Redirect URI: https://yoursite.com/admin/oauth-callback
# ============================================================
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# Discord sign-in (optional)
# Portal: https://discord.com/developers/applications
# Redirect URI: https://yoursite.com/admin/oauth-callback?provider=discord
# Scopes needed: identify, email
# ============================================================
DISCORD_AUTH_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ============================================================
# Avatars
# Online (premium) players are looked up by UUID; offline (cracked)
# players don't have one Crafatar can resolve, so they're looked up by name.
# ============================================================
AVATAR_URL=https://crafatar.com/avatars/{uuid}?size=64&overlay=true
AVATAR_URL_OFFLINE=https://cravatar.eu/avatar/{name}/64

# ============================================================
# Ban protest / appeal page
# ============================================================
PROTEST_DISCORD=#
PROTEST_EMAIL=admin@example.com
PROTEST_FORUM=#

# ============================================================
# What shows on the site
# ============================================================
SHOW_PLAYER_UUID=true
SHOW_SILENT_PUNISHMENTS=true
SHOW_SERVER_ORIGIN=true
SHOW_SERVER_SCOPE=true
SHOW_CONTACT_DISCORD=true
SHOW_CONTACT_EMAIL=true
SHOW_CONTACT_FORUM=true
SHOW_MENU_PROTEST=true
SHOW_MENU_STATS=true
SHOW_MENU_ADMIN=true

# ============================================================
# SEO
# Crawler access, Google Analytics, the cookie notice and the privacy
# page text are all set from the admin panel (SEO & Tracking tab), not here.
# ============================================================
SITE_LANG=en
SITE_ROBOTS=index, follow
SITE_TITLE_TEMPLATE={page} - {site}
SITE_FAVICON=favicon.ico
SITE_APPLE_ICON=apple-touch-icon.png
SITE_THEME_COLOR=#ef4444
SITE_OG_IMAGE=
SITE_KEYWORDS=
SEO_ENABLE_SCHEMA=true
SEO_ENABLE_BREADCRUMBS=true
SEO_LOCALE=en_US
# Set to false to send AI crawlers (GPTBot, ClaudeBot, ...) a noindex/nofollow signal
SEO_AI_TRAINING=true
SEO_ORGANIZATION_NAME=
SEO_CONTACT_EMAIL=
SEO_CONTACT_PHONE=
SEO_SOCIAL_FACEBOOK=
SEO_SOCIAL_TWITTER=
SEO_SOCIAL_YOUTUBE=

# ============================================================
# Security
# ============================================================
SESSION_LIFETIME=3600
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=3600

# ============================================================
# Cache
# ============================================================
CACHE_ENABLED=true
CACHE_LIFETIME=3600

# ============================================================
# Debugging — leave off in production
# ============================================================
DEBUG=false
LOG_ERRORS=true
ERROR_LOG_PATH=logs/error.log
